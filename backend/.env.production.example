# Salin menjadi backend/.env di server (jangan di-commit). Isi nilai rahasia sendiri.
APP_NAME="ORCA X Mobile"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://orca.example.com
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr            # log ke output container (docker logs)
LOG_LEVEL=warning

# Database bersama aplikasi web lama (jangan migrate:fresh)
DB_CONNECTION=mysql
DB_HOST=host.docker.internal  # atau alamat/hostname server MySQL
DB_PORT=3306
DB_DATABASE=proenergi
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Web Push (jangan diganti setelah ada pengguna berlangganan)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@proenergi.co.id

# Accurate Online (nonaktif sampai diisi). Lihat backend/ACCURATE.md
ACCURATE_ENABLED=false
ACCURATE_TOKEN=
ACCURATE_SIGNATURE_SECRET=

# Email notifikasi approval (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
